APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DESTRUCTIVE_COMMANDS_ALLOWED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pasona_finance
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Sanctum bearer-token expiry (in minutes). 1440 = 1 day.
SANCTUM_TOKEN_EXPIRY_MINUTES=1440

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pasona mailing system
# ----------------------
# Verification + reset-password + daily reminders all use the
# default mailer above. Switch to smtp/resend/postmark here when
# ready to send real mail.
#
#   smtp      — generic SMTP (Mailgun, Gmail workspace, etc.)
#   resend    — resend.com (recommended for transactional)
#   postmark  — postmarkapp.com
#   log       — writes every email to storage/logs/laravel.log
#
# MAIL_MAILER=resend
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_xxx
# MAIL_FROM_ADDRESS="hello@pasona.adebayosystems.com.ng"
# MAIL_FROM_NAME="Pasona"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public API Documentation Site
API_BASE_URL=http://localhost:8000/api
API_DISPLAY_NAME="Your API"
API_VERSION=v1

# Web Push Notifications (VAPID)
# Generate keys with: php artisan webpush:generate-keys (after installing minishlink/web-push)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@pasona.app


# Broadcast announcement secret key
# Set a random string here, then trigger announcements by visiting:
#   https://yoursite.com/admin/announce/reminder-announcement?key=YOUR_SECRET
# ADMIN_KEY=some-long-random-string
