<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen logo: wraps the brand-name-logo-dark.png bitmap and forces
     it to fit within the icon area without cropping, centered on a transparent
     background so windowSplashScreenIconBackgroundColor handles the fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="97dp"
        android:height="32dp"
        android:gravity="center">
        <bitmap
            android:src="@mipmap/ic_splash_fg"
            android:gravity="fill" />
    </item>
</layer-list>
