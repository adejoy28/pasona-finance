# =============================================================================
# Pasona Finance — frontend environment template
# =============================================================================
# Copy to `.env` (or `.env.local` for personal overrides) and edit. The
# committed `.env` is the default; `.env.local` (gitignored) overrides it.
#
# Vite bakes VITE_* values at build time, so after editing you MUST restart
# the dev server — hot-reload is not enough.
#
# Switching environments = changing VITE_API_BASE_URL. Nothing in the source
# code hardcodes a backend URL; everything reads from this variable.
# =============================================================================


# ---- LOCAL DEV (default — works out of the box) ----------------------------
# Vite's dev server proxies `/api/*` to the PHP backend on :8000.
# Browser requests stay same-origin, so CORS isn't required.
VITE_API_BASE_URL=/api
VITE_BACKEND_ORIGIN=http://localhost:8000


# ---- TESTING AGAINST A REMOTE / NON-PROXIED BACKEND ------------------------
# Uncomment to bypass the Vite proxy and hit a backend directly.
# Make sure the backend allows your frontend origin via CORS_ALLOWED_ORIGINS.
#
#   VITE_API_BASE_URL=http://localhost:8000/api
#   VITE_API_BASE_URL=https://staging-api.example.com/api


# ---- PRODUCTION ------------------------------------------------------------
# Edit `.env.production` for deployed builds. `vite build` loads it
# automatically; do not commit production URLs to `.env`.


# ---- APP METADATA ----------------------------------------------------------
VITE_APP_NAME=Pasona


# ---- ANDROID APK (optional, shown on the web Settings page) ----------------
# VITE_ANDROID_APK_URL=https://downloads.pasona.app/pasona.apk
# VITE_ANDROID_APK_VERSION=1.0.0
# VITE_ANDROID_APK_SIZE=4.3 MB


# ---- WEB PUSH NOTIFICATIONS (server-only) ----------------------------------
# Generate VAPID keys with: node scripts/generate-vapid-keys.mjs
# VAPID_PUBLIC_KEY=BGn...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:support@pasona.app


# ---- AI INSIGHTS (server-only) ---------------------------------------------
# `groq` is free and OpenAI-compatible. Get a key at https://console.groq.com/keys
# Set `AI_PROVIDER=openai` and supply `OPENAI_API_KEY` to switch.
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here
# OPENAI_API_KEY=your-openai-key-here
# Optional model override (defaults to a sensible model per provider).
# AI_MODEL=llama-3.3-70b-versatile
